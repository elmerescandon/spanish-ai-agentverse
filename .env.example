# Copy to .env and fill in real values: cp .env.example .env
# List every key the backend reads here, with an empty value and a comment.
# Never put real secrets in this file; it is committed to git.

# --------------------------------------------------------------------------
# Next.js Frontend / Vercel Proxy
# --------------------------------------------------------------------------
# Base URL of upstream FastAPI backend used by Next.js API rewrites
FASTAPI_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------------
# FastAPI Server & CORS Settings
# --------------------------------------------------------------------------
# Network interface to bind the FastAPI backend server
BACKEND_HOST=0.0.0.0

# TCP port to listen on for HTTP requests
BACKEND_PORT=8000

# Comma-separated CORS allowed origins (include production frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------------------
# Google Gemini LLM API (backend/clients/)
# --------------------------------------------------------------------------
# Google Gemini API key for clinical protocol extraction & analysis
GEMINI_API_KEY=

# Gemini model identifier
GEMINI_MODEL=gemini-4-argon

# Faster model used only by the completeness check (empty = gemini-3.8-flash)
CHECK_MODEL=

# --------------------------------------------------------------------------
# Analysis result cache (backend/api/protocol_pipeline.py)
# --------------------------------------------------------------------------
# Folder for finished parses and checks, reused across restarts;
# delete it (make clear-cache) to force a fresh analysis
RESULT_CACHE_DIR=

# --------------------------------------------------------------------------
# Protocol review database (backend/clients/protocol_db.py)
# --------------------------------------------------------------------------
# SQLite file with each uploaded protocol's fields and the changes a
# reviewer accepted; kept across restarts, not cleared by make clear-cache
PROTOCOL_DB_PATH=

# --------------------------------------------------------------------------
# Uploaded protocol documents (backend/clients/document_store.py)
# --------------------------------------------------------------------------
# Vercel Blob token. Vercel injects it into deployments; it is read from
# the process environment (export it, a .env entry is not enough). Leave
# unset locally to keep uploaded documents in memory instead.
# On Vercel it also holds the protocol review data (fields, offers and
# accepted changes). When it is unset, that data falls back to the local
# SQLite file at PROTOCOL_DB_PATH.
BLOB_READ_WRITE_TOKEN=

# --------------------------------------------------------------------------
# Clinical Data Sources (Step 2 & Step 3)
# --------------------------------------------------------------------------
# PostgreSQL connection URL for ClinicalTrials.gov AACT database
AACT_DB_URL=

# Filesystem path to MIMIC-IV clinical dataset directory
MIMIC_DATA_PATH=

# Filesystem path to Synthea synthetic patient dataset directory
SYNTHEA_DATA_PATH=
