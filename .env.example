# Copy to .env and fill in real values: cp .env.example .env
# List every key the backend reads here, with an empty value and a one-line comment.
# Never put real secrets in this file; it is committed.

# Google Gemini API key used by backend/clients/gemini.py
GEMINI_API_KEY=

# Gemini model identifier used for protocol extraction
GEMINI_MODEL=gemini-4-argon
