    "identificationModule": {
      "nctId": "NCT02131272",
      "briefTitle": "A Trial Investigating the Efficacy and Safety of Insulin Detemir Versus Insulin NPH in Combination With Metformin and Diet/Exercise in Children and Adolescents With Type 2 Diabetes Insufficiently Controlled on Metformin With or Without Other Oral Antidiabetic Drug(s) With or Without Basal Insulin",
      "officialTitle": "A 26-week Open Label, Randomised, 2-armed, Parallel Group, Multi-centre Trial Investigating Efficacy and Safety of Insulin Detemir Versus Insulin Neutral Protamine Hagedorn in Combination With the Maximum Tolerated Dose of Metformin and Diet/Exercise on Glycaemic Control in Children and Adolescents With Type 2 Diabetes Insufficiently Controlled on the Maximum Tolerated Dose of Metformin ± Other Oral Antidiabetic Drug(s) ± Basal Insulin"
    },
